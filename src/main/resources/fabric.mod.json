{
  "schemaVersion": 1,
  "name": "Zenith Client 2.0",
  "id": "meteor-client",
  "version": "${version}",
  "description": "Purple visual client for Minecraft 26.2. A GPL-3.0 fork of Meteor Client with Zenith UI, HUD and effects.",
  "authors": [
    "Zenith contributors",
    "MineGame159",
    "squidoodly",
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/davyduao-hue/Zenith-Codex-Cloud",
    "issues": "https://github.com/davyduao-hue/Zenith-Codex-Cloud/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/zenith/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "meteordevelopment.meteorclient.MeteorClient"
    ],
    "modmenu": [
      "meteordevelopment.meteorclient.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "meteor-client.mixins.json",
    "meteor-client-baritone.mixins.json",
    "meteor-client-indigo.mixins.json",
    "meteor-client-sodium.mixins.json",
    "meteor-client-lithium.mixins.json",
    "meteor-client-viafabricplus.mixins.json",
    "zenith.mixins.json"
  ],
  "accessWidener": "meteor-client.classtweaker",
  "custom": {
    "meteor-client:build_number": "${build_number}",
    "meteor-client:color": "183,117,255",
    "meteor-client:commit": "${commit}",
    "badoptimizations:cache_hooks": {
      "lightmap": "meteordevelopment.meteorclient.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1"
  }
}
